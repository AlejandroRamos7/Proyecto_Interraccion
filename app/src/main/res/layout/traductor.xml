<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.App"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_sparkle"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/cian"
                    android:lineSpacingExtra="3dp"
                    android:padding="16dp"
                    android:text="Pega el texto de un análisis o adjunta una foto. La IA lo explica con palabras sencillas y señala lo que está fuera de rango. No diagnostica."
                    android:textColor="@color/texto"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="¿De quién es el análisis?">

                <AutoCompleteTextView
                    android:id="@+id/actPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/T.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NIVEL DE EXPLICACIÓN" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsNivel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSencillo"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Muy sencillo" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDetallado"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Con más detalle" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Pega aquí los resultados del análisis">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etResultados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/filaImagen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_fecha"
                    android:contentDescription="Foto adjunta"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Foto adjunta"
                    android:textColor="@color/texto"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuitar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quitar"
                    android:textColor="@color/rojo" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImagen"
                style="@style/Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Adjuntar foto del análisis"
                app:icon="@drawable/ic_image"
                app:iconTint="@color/azul_claro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTraducir"
                style="@style/Boton.Principal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Traducir con IA"
                app:icon="@drawable/ic_sparkle" />

            <LinearLayout
                android:id="@+id/progreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    style="@style/T.Subtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Analizando tu resultado…" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistorial"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ver análisis anteriores"
                android:textColor="@color/azul_claro"
                app:icon="@drawable/ic_history"
                app:iconTint="@color/azul_claro" />

            <TextView
                style="@style/T.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Para generar la explicación, el texto o la foto se envían de forma cifrada a un servicio de IA. Evita incluir nombres o números de identificación."
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
