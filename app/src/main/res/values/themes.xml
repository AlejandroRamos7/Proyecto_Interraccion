<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Proyecto_Interaccion" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/azul</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/azul_oscuro</item>
        <item name="colorOnPrimaryContainer">@color/texto</item>
        <item name="colorSecondary">@color/cian</item>
        <item name="colorOnSecondary">@color/negro</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorSurfaceVariant">@color/superficie2</item>
        <item name="colorOnSurfaceVariant">@color/texto_suave</item>
        <item name="colorSurfaceContainer">@color/superficie</item>
        <item name="colorSurfaceContainerHigh">@color/superficie2</item>
        <item name="colorSurfaceContainerHighest">@color/superficie2</item>
        <item name="colorOutline">@color/borde</item>
        <item name="colorOutlineVariant">@color/borde</item>
        <item name="colorError">@color/rojo</item>
        <item name="android:colorBackground">@color/negro</item>
        <item name="android:windowBackground">@color/negro</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_suave</item>
        <item name="android:textColorHint">@color/texto_suave</item>
    </style>

    <style name="Theme.Proyecto_Interaccion" parent="Base.Theme.Proyecto_Interaccion" />

    <!-- Tarjetas -->
    <style name="Card.App" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Botones -->
    <style name="Boton.Principal" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/azul</item>
        <item name="android:textColor">@color/azul_claro</item>
    </style>

    <style name="T.Titulo" parent="">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="T.Subtitulo" parent="">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="T.Seccion" parent="">
        <item name="android:textColor">@color/cian</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
</resources>